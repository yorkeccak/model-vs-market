# OpenAI API key (Decisions API) - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Valyu API key (news search) - https://platform.valyu.ai
VALYU_API_KEY=

# Vercel AI Gateway key (TypeSafe Jev) - https://vercel.com/dashboard > AI Gateway > API Keys
AI_GATEWAY_API_KEY=

# Cloudflare Workers AI (Clef) - API token with Workers AI permission + your account id
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Protects the scheduled board refresh (/api/cron/board). Any long random string.
CRON_SECRET=

# Optional: max uncached analyses per day across all users (default 2000).
MAX_DAILY_ANALYSES=
