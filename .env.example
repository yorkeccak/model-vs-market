# OpenAI Decisions API - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# News search - https://platform.valyu.ai
VALYU_API_KEY=

# Cloudflare Clef on Workers AI - https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# TypeSafe Jev - set either one. TYPESAFE_API_KEY is used directly if present,
# otherwise Jev runs through Vercel AI Gateway.
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=

# Deploy only: protects the scheduled board refresh. Any long random string.
CRON_SECRET=

# Optional: max fresh analyses per day across all users (default 10000).
MAX_DAILY_ANALYSES=
